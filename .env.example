# PiHound Frontend Environment Configuration

# Option A: Local Development (Default with Vite Proxy)
# Relative path '/api' routed via Vite dev proxy or Nginx reverse proxy
VITE_API_BASE_URL=/api

# Vite Dev Server Proxy Target (Django Backend address)
VITE_BACKEND_PROXY_URL=http://localhost:8000

# Option B: Cloud / Static Hosting (Vercel, Dokploy, Netlify)
# Point directly to your deployed backend API URL:
# VITE_API_BASE_URL=https://api.yourdomain.com/api

# Community & External Links
# Official Pi Explorer (Web Link)
VITE_EXPLORER_URL=https://explorer.minepi.com

# Application Brand & Metadata
VITE_APP_NAME=PiHound
VITE_APP_TITLE=PiHound — Pi Network Analytics & Explorer

# Official Community & Social Channels
VITE_TWITTER_URL=https://x.com/pihoundofficial
VITE_GITHUB_URL=https://github.com/PIHound-Lab/
VITE_TELEGRAM_URL=https://t.me/pihound
